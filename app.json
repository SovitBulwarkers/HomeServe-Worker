{
  "expo": {
    "name": "HomeServe Pro",
    "slug": "homeserve-worker",
    "scheme": "homeserveworker",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#E8730A"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "HomeServe Pro uses your location to show nearby jobs and share live tracking with customers while a job is in progress."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "HomeServe Pro needs camera access so you can take before/after job-proof photos.",
          "microphonePermission": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homeserve.worker",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "HomeServe Pro needs camera access so you can take before/after job-proof photos."
      }
    },
    "android": {
      "package": "com.homeserve.worker",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E8730A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "navigationBarColor": "#F5F1EB",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e1a2e0a-d863-484d-b808-0be6140582e7"
      }
    }
  }
}